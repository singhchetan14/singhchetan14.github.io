---
import { Menu, X } from 'lucide-astro';
import { nav } from '../../data/site';
---
<header class="sticky top-0 z-50 border-b border-primary/10 bg-bg/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href="#top" class="flex items-center gap-3">
      <img src="/logo.jpeg" alt="Rotaract Club of Bharatpur logo" width="36" height="36" class="size-9 rounded-md object-contain" />
      <span class="font-heading text-sm font-bold leading-tight text-primary">Rotaract Club<br /><span class="font-medium text-muted">of Bharatpur</span></span>
    </a>
    <nav aria-label="Primary" class="hidden items-center gap-8 md:flex">
      {nav.map((n) => <a href={n.href} class="text-sm font-medium text-ink hover:text-secondary">{n.label}</a>)}
      <a href="#contact" class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white hover:bg-secondary">Join Us</a>
    </nav>
    <button id="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Toggle menu"
      class="grid size-11 place-items-center rounded-lg md:hidden">
      <Menu class="size-6" data-open /><X class="hidden size-6" data-close />
    </button>
  </div>
  <nav id="mobile-nav" aria-label="Mobile" class="hidden border-t border-primary/10 bg-bg px-5 pb-4 md:hidden">
    {nav.map((n) => <a href={n.href} class="block py-3 text-base font-medium">{n.label}</a>)}
    <a href="#contact" class="mt-2 block rounded-lg bg-primary px-4 py-3 text-center font-semibold text-white">Join Us</a>
  </nav>
</header>
<script>
  const btn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('mobile-nav')!;
  const toggle = (open: boolean) => {
    menu.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
    btn.querySelector('[data-open]')!.classList.toggle('hidden', open);
    btn.querySelector('[data-close]')!.classList.toggle('hidden', !open);
  };
  btn.addEventListener('click', () => toggle(menu.classList.contains('hidden')));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => toggle(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && toggle(false));
</script>
