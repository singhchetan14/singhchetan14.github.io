---
import SocialLinks from '../ui/SocialLinks.astro';
import { site, nav } from '../../data/site';
---
<footer class="bg-[#0e203a] text-white/75">
  <div class="mx-auto grid max-w-6xl gap-8 px-5 py-12 md:grid-cols-[1.5fr_1fr_auto] md:items-start">
    <div>
      <p class="font-heading text-lg font-bold text-white">{site.name}</p>
      <p class="mt-1 text-sm text-accent">{site.motto}</p>
    </div>
    <nav aria-label="Footer"><ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
      {nav.map((n) => <li><a href={n.href} class="hover:text-accent">{n.label}</a></li>)}
    </ul></nav>
    <SocialLinks class="text-white" />
  </div>
  <p class="border-t border-white/10 px-5 py-5 text-center text-xs">© {new Date().getFullYear()} {site.name}. All rights reserved.</p>
</footer>
