---
import Button from '../ui/Button.astro';
import { site } from '../../data/site';
---
<section id="top" class="relative overflow-hidden bg-primary text-white">
  <div class="pointer-events-none absolute -right-32 -top-32 size-96 rounded-full border border-accent/20" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-10 -top-10 size-64 rounded-full border border-accent/10" aria-hidden="true"></div>
  <div class="relative mx-auto grid max-w-6xl gap-12 px-5 py-20 sm:py-28 lg:grid-cols-[1.4fr_1fr] lg:items-center">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-accent">{site.district}</p>
      <h1 class="mt-4 text-4xl font-extrabold leading-[1.1] tracking-tight !text-white sm:text-6xl">Fellowship Through Service<span class="text-accent">.</span></h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/85">A community of young leaders committed to service, leadership, fellowship and positive change.</p>
      <p class="mt-3 max-w-xl text-white/65">Meaningful change begins with people who care enough to take action.</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <Button href="#contact">Connect With Us</Button>
        <Button href="#about" variant="secondary">Discover Our Club</Button>
      </div>
    </div>
    <!-- Typography-led panel. Swap for a real club photo when available. -->
    <dl class="grid gap-px overflow-hidden rounded-xl border border-white/15 bg-white/15 text-sm">
      {[['Established', site.established], ['Based in', site.location]].map(([k, v]) => (
        <div class="bg-primary px-6 py-4"><dt class="text-xs uppercase tracking-widest text-accent">{k}</dt><dd class="mt-1 font-semibold">{v}</dd></div>
      ))}
    </dl>
  </div>
</section>
