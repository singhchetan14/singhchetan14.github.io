---
import SectionHeading from '../ui/SectionHeading.astro';
import { Lightbulb, Briefcase, HandHeart, Users } from 'lucide-astro';
const pillars = [
  { icon: Lightbulb, title: 'Leadership', text: 'Young people exchange ideas and grow as leaders.' },
  { icon: Briefcase, title: 'Professional Growth', text: 'Skills and experience that shape future careers.' },
  { icon: HandHeart, title: 'Community Service', text: 'Action that serves the communities around us.' },
  { icon: Users, title: 'Fellowship', text: 'Friendship and collaboration across borders.' },
];
---
<section id="about" aria-labelledby="about-rotaract" class="py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeading eyebrow="Global Network" id="about-rotaract" title="About Rotaract"
      lead="Rotaract is a global network of young leaders who come together to exchange ideas, develop leadership and professional skills, and serve their communities." />
    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {pillars.map((p) => (
        <li class="rounded-xl border border-primary/10 bg-surface p-6 shadow-sm">
          <p.icon class="size-7 text-secondary" aria-hidden="true" />
          <h3 class="mt-4 text-lg font-bold">{p.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{p.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
