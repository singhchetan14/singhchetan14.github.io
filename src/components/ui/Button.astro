---
interface Props { href: string; variant?: 'primary' | 'secondary' | 'ghost'; class?: string }
const { href, variant = 'primary', class: cls = '' } = Astro.props;
const ext = /^https?:/.test(href);
const styles = {
  primary: 'bg-accent text-primary hover:bg-[#e2bb6b]',
  secondary: 'border border-white/40 text-white hover:bg-white/10',
  ghost: 'border border-primary/20 text-primary hover:bg-primary hover:text-white',
}[variant];
---
<a href={href} {...(ext ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
  class:list={['inline-flex min-h-11 items-center justify-center gap-2 rounded-lg px-5 py-2.5 text-sm font-semibold transition-colors', styles, cls]}>
  <slot />
</a>
